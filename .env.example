# MongoDB Atlas
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/civicconnect?retryWrites=true&w=majority

# Auth
JWT_SECRET=use_a_long_random_string
JWT_ACCESS_EXPIRES=15m
REFRESH_EXPIRES_DAYS=30

# CORS — comma-separated origins (Vercel frontend + local dev)
CORS_ORIGINS=https://your-app.vercel.app,http://localhost:5173
FRONTEND_URL=https://your-app.vercel.app

# Server
PORT=5000
NODE_ENV=production

# Optional: AI (Gemini)
GEMINI_API_KEY=

# Optional: uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
